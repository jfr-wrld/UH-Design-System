{
  "name": "umrahhaji-ds",
  "version": "0.0.0",
  "private": true,
  "description": "UmrahHaji Design System monorepo",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "clean": "pnpm -r clean && rm -rf node_modules packages/*/node_modules apps/*/node_modules",
    "dev": "pnpm --filter @umrahhaji/storybook dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ds": "node ./scripts/lint-ds.mjs",
    "test": "pnpm -r test",
    "test:a11y": "pnpm --filter @umrahhaji/storybook test:a11y:ci",
    "typecheck": "pnpm -r typecheck",
    "bundle-size": "pnpm --filter @umrahhaji/ui build && node ./packages/ui/scripts/bundle-size.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^0.12.0",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild"
    ]
  }
}
