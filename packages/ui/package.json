{
  "name": "@umrahhaji/ui",
  "version": "0.0.0",
  "private": true,
  "description": "React component library for the UmrahHaji design system",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:js && pnpm run build:css && pnpm run build:fonts",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "build:fonts": "rm -rf ./dist/fonts && cp -R ../tokens/build/css/fonts ./dist/fonts",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "dev": "vite build --watch",
    "test": "node ./scripts/verify-tokens.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:tokens": "node ./scripts/verify-tokens.mjs"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.0.0",
    "@tailgrids/icons": "^2.0.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "recharts": "^3.0.0"
  },
  "dependencies": {
    "@umrahhaji/tokens": "workspace:*",
    "country-flag-icons": "^1.6.20"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@storybook/react": "^8.6.18",
    "@tailgrids/icons": "^2.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.19.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "rollup": "^4.63.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^4.1.11"
  }
}
